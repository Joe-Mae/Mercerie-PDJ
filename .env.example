# Variables publiques utilisées par l'application web (visibles dans le navigateur).
# Ne jamais y placer de clé de service.
VITE_SUPABASE_URL=https://<projet>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<clé-publiable>

# Clé publique VAPID des notifications Web Push (npm run vapid:generate).
# La clé privée reste exclusivement dans les secrets Supabase, jamais ici.
VITE_VAPID_PUBLIC_KEY=

# Variables locales du script de création des comptes.
# Utiliser une clé de service uniquement sur la machine de l'administrateur.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Identifiant de la boutique Mercerie PDJ (valeur du seed).
BOUTIQUE_ID=b7e2c1a4-5d6f-4e8a-9b0c-1d2e3f4a5b6c
